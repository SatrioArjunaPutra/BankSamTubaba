# TEMPLATE saja: isi nilai sebenarnya di Railway Variables (API dan scheduler).
# Jangan menimpa .env lokal atau mengisi rahasia di file contoh ini.
# Scheduler memakai variabel yang sama, kecuali PROCESS_ROLE=scheduler.
APP_NAME=BankSampahTubaba
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-staging.example.invalid
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Salin Session pooler dari menu Connect di Supabase DEV; bukan Transaction pooler.
# Host dan username harus disalin dari dashboard, jangan ditebak dari region.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Origin web HTTPS saja, tanpa /api/v1 atau path lain. Pisahkan dengan koma.
CORS_ALLOWED_ORIGINS=https://web-staging.example.invalid
SANCTUM_EXPIRATION=10080
FITUR_IOT=false

# S3 Access Key ID dan Secret Access Key hanya di backend, bukan VITE_/APK.
# Salin endpoint dan region dari S3 configuration Supabase DEV.
# URL publik: https://<project-ref>.supabase.co/storage/v1/object/public/uploads
# Bucket uploads saat ini publik: gunakan foto/data sintetis pada staging.
UPLOAD_DISK=supabase
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=uploads
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_URL=

# Password kuat khusus akun demo staging, bukan password akun pribadi.
# Seeder tidak mengganti password akun demo yang sudah ada.
SEED_DEMO_PASSWORD=

# API: api; service scheduler: scheduler. PORT disediakan oleh Railway.
PROCESS_ROLE=api
