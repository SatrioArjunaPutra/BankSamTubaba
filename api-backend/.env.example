APP_NAME="Bank Sampah Tubaba"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Profil database (pilih salah satu):
# (a) LOKAL Sail/Docker (default di bawah). Container pgsql dibuat dari nilai ini.
# (b) SUPABASE: diisi HANYA di Railway (Session pooler, port 5432), jangan di laptop:
#     DB_HOST=<host Session pooler dari dashboard Supabase>
#     DB_PORT=5432
#     DB_DATABASE=postgres
#     DB_USERNAME=postgres.<project-ref>
#     DB_PASSWORD=<dari dashboard Supabase>
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=bank_sampah
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Bank Sampah ---
# Masa berlaku token login dalam menit (10080 = 7 hari)
SANCTUM_EXPIRATION=10080

# Origin frontend yang diizinkan, dipisah koma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sensor IoT ditunda: route /api/sensor hanya aktif jika true
FITUR_IOT=false

# Akun awal untuk db:seed.
# production: hanya akun dlh yang dibuat; SEED_ADMIN_EMAIL + SEED_ADMIN_PASSWORD wajib diisi.
# local: data DEMO (3 bank sampah, operator, bentor, warga) ikut dibuat dengan satu
# password bersama SEED_DEMO_PASSWORD; kosong = acak & ditampilkan sekali di console.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Hanya untuk migrate di production: izinkan menghapus tabel transactions Tahap 1
# yang masih berisi data (backup dulu). Lihat migration 2026_10_28_000008.
# IZINKAN_HAPUS_TRANSACTIONS=false

# Disk untuk file unggahan (foto penjemputan & preloved).
# Lokal/test: public (jalankan `php artisan storage:link`). Produksi/staging: supabase.
UPLOAD_DISK=public

# Supabase Storage (protokol S3), diisi HANYA di Railway. Bucket publik "uploads".
# Key dibuat di Supabase: Project Settings → Storage → S3 Access Keys.
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=uploads
# https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=
# https://<project-ref>.supabase.co/storage/v1/object/public/uploads
SUPABASE_S3_URL=
